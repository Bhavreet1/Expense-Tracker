# Dependencies
node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
dist-ssr/
build/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.*

# Testing & Coverage
coverage/
.nyc_output/

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Vite & Bundler Cache
.vite/
.turbo/
.cache/
.parcel-cache/

# AI Assistants & Agent Scratch
.agents/
.claude/
.cursor/
.gemini/
.system_generated/
scratch/